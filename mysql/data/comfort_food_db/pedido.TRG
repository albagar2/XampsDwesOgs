TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER trg_validar_cupon_pedido\nBEFORE UPDATE ON Pedido\nFOR EACH ROW\nBEGIN\n    IF OLD.id_cupon_usado IS NOT NULL\n       AND NEW.id_cupon_usado IS NOT NULL\n       AND OLD.id_cupon_usado <> NEW.id_cupon_usado THEN\n        SIGNAL SQLSTATE \'45000\'\n        SET MESSAGE_TEXT = \'Solo se permite un cupón por pedido\';\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_ganar_puntos_pedido\nAFTER UPDATE ON Pedido\nFOR EACH ROW\nBEGIN\n    DECLARE puntos INT;\n    DECLARE regla DECIMAL(5,2);\n\n    IF OLD.id_estado_pedido <> NEW.id_estado_pedido\n       AND NEW.id_estado_pedido = (\n           SELECT id_estado_pedido\n           FROM Estado_Pedido\n           WHERE nombre_estado = \'Entregado\'\n       ) THEN\n\n        SELECT puntos_por_unidad_monetaria\n        INTO regla\n        FROM Configuracion_Fidelidad\n        ORDER BY id_configuracion DESC\n        LIMIT 1;\n\n        SET puntos = FLOOR(NEW.precio_total * regla);\n\n        UPDATE Fidelidad_Puntos\n        SET saldo_puntos = saldo_puntos + puntos\n        WHERE id_cliente = NEW.id_cliente;\n\n        INSERT INTO Historico_Puntos (\n            id_cliente,\n            puntos_movimiento,\n            id_pedido_origen,\n            tipo_movimiento\n        ) VALUES (\n            NEW.id_cliente,\n            puntos,\n            NEW.id_pedido,\n            \'Ganancia por Compra\'\n        );\n    END IF;\nEND' 'CREATE DEFINER=`root`@`localhost` TRIGGER trg_usar_cupon\nAFTER UPDATE ON Pedido\nFOR EACH ROW\nBEGIN\n    DECLARE v_costo INT;\n\n    IF NEW.id_cupon_usado IS NOT NULL\n       AND OLD.id_cupon_usado IS NULL THEN\n\n        -- Validar caducidad (15 días)\n        IF NOT EXISTS (\n            SELECT 1 FROM Cupon_Cliente\n            WHERE id_cupon = NEW.id_cupon_usado\n              AND id_cliente = NEW.id_cliente\n              AND usado = FALSE\n              AND fecha_asignacion >= NOW() - INTERVAL 15 DAY\n        ) THEN\n            SIGNAL SQLSTATE \'45000\'\n            SET MESSAGE_TEXT = \'Cupón no válido o caducado\';\n        END IF;\n\n        -- Marcar cupón como usado\n        UPDATE Cupon_Cliente\n        SET usado = TRUE, fecha_uso = CURRENT_TIMESTAMP\n        WHERE id_cupon = NEW.id_cupon_usado\n          AND id_cliente = NEW.id_cliente;\n\n        -- Descontar puntos\n        SELECT costo_puntos INTO v_costo\n        FROM Cupon WHERE id_cupon = NEW.id_cupon_usado;\n\n        UPDATE Fidelidad_Puntos\n        SET saldo_puntos = saldo_puntos - v_costo\n        WHERE id_cliente = NEW.id_cliente;\n\n        INSERT INTO Historico_Puntos (\n            id_cliente, puntos_movimiento, id_pedido_origen, tipo_movimiento\n        ) VALUES (\n            NEW.id_cliente, -v_costo, NEW.id_pedido, \'Canje por Cupón\'\n        );\n    END IF;\nEND'
sql_modes=1098907648 1098907648 1098907648
definers='root@localhost' 'root@localhost' 'root@localhost'
