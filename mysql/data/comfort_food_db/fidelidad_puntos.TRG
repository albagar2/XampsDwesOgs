TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` TRIGGER trg_cupones_por_puntos\nAFTER UPDATE ON Fidelidad_Puntos\nFOR EACH ROW\nBEGIN\n    DECLARE v_id_usuario INT;\n\n    SELECT id_usuario INTO v_id_usuario\n    FROM Cliente WHERE id_cliente = NEW.id_cliente;\n\n    IF OLD.saldo_puntos < 100 AND NEW.saldo_puntos >= 100 THEN\n        INSERT IGNORE INTO Cupon_Cliente (id_cupon, id_cliente)\n        VALUES ((SELECT id_cupon FROM Cupon WHERE codigo=\'FID_100_5\'), NEW.id_cliente);\n\n        INSERT INTO Notificacion VALUES (\n            NULL, v_id_usuario, \'Cupón Fidelidad\',\n            \'Has conseguido un cupón del 5%. Tienes 15 días para usarlo.\',\n            FALSE, CURRENT_TIMESTAMP\n        );\n    END IF;\n\n    IF OLD.saldo_puntos < 250 AND NEW.saldo_puntos >= 250 THEN\n        INSERT IGNORE INTO Cupon_Cliente (id_cupon, id_cliente)\n        VALUES ((SELECT id_cupon FROM Cupon WHERE codigo=\'FID_250_10\'), NEW.id_cliente);\n\n        INSERT INTO Notificacion VALUES (\n            NULL, v_id_usuario, \'Cupón Fidelidad\',\n            \'Has conseguido un cupón del 10%. Tienes 15 días para usarlo.\',\n            FALSE, CURRENT_TIMESTAMP\n        );\n    END IF;\n\n    IF OLD.saldo_puntos < 500 AND NEW.saldo_puntos >= 500 THEN\n        INSERT IGNORE INTO Cupon_Cliente (id_cupon, id_cliente)\n        VALUES ((SELECT id_cupon FROM Cupon WHERE codigo=\'FID_500_15\'), NEW.id_cliente);\n\n        INSERT INTO Notificacion VALUES (\n            NULL, v_id_usuario, \'Cupón Fidelidad\',\n            \'Has conseguido un cupón del 15%. Tienes 15 días para usarlo.\',\n            FALSE, CURRENT_TIMESTAMP\n        );\n    END IF;\nEND'
sql_modes=1098907648
definers='root@localhost'
