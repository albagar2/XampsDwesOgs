TYPE=TRIGGERS
triggers='CREATE DEFINER=`root`@`localhost` trigger aipartido after insert on partido\nfor each row\nbegin\n\nif (new.g1> new.g2) then update equipo set puntos=puntos+3 where id=new.e1;\nupdate equipo set v=v+1 where id=new.e1; \nupdate equipo set d=d+1 where id=new.e2;\nelseif (new.g1< new.g2) then update equipo set puntos=puntos+3 where id=new.e2;\nupdate equipo set v=v+1 where id=new.e2; \nupdate equipo set d=d+1 where id=new.e1;\nelse update equipo set puntos=puntos+1 where id=new.e1;\nupdate equipo set puntos=puntos+1 where id=new.e2;\nupdate equipo set e=e+1 where id=new.e2; \nupdate equipo set e=e+1 where id=new.e1;\nend if;\nupdate equipo set gf=gf+new.g1 where id=new.e1;\nupdate equipo set gf=gf+new.g2 where id=new.e2;\nupdate equipo set gc=gc+new.g2 where id=new.e1;\nupdate equipo set gc=gc+new.g1 where id=new.e2;\n\n\nend' 'CREATE DEFINER=`root`@`localhost` trigger aupartido after update on partido\nfor each row\nbegin\n\nif (old.g1> old.g2) then update equipo set puntos=puntos-3 where id=old.e1;\nupdate equipo set v=v-1 where id=old.e1; \nupdate equipo set d=d-1 where id=old.e2;\nelseif (old.g1< old.g2) then update equipo set puntos=puntos-3 where id=old.e2;\nupdate equipo set v=v-1 where id=old.e2; \nupdate equipo set d=d-1 where id=old.e1;\nelse update equipo set puntos=puntos-1 where id=old.e1;\nupdate equipo set puntos=puntos-1 where id=old.e2;\nupdate equipo set e=e-1 where id=old.e2; \nupdate equipo set e=e-1 where id=old.e1;\nend if;\nupdate equipo set gf=gf-old.g1 where id=old.e1;\nupdate equipo set gf=gf-old.g2 where id=old.e2;\nupdate equipo set gc=gc-old.g2 where id=old.e1;\nupdate equipo set gc=gc-old.g1 where id=old.e2;\n\nif (new.g1> new.g2) then update equipo set puntos=puntos+3 where id=new.e1;\nupdate equipo set v=v+1 where id=new.e1; \nupdate equipo set d=d+1 where id=new.e2;\nelseif (new.g1< new.g2) then update equipo set puntos=puntos+3 where id=new.e2;\nupdate equipo set v=v+1 where id=new.e2; \nupdate equipo set d=d+1 where id=new.e1;\nelse update equipo set puntos=puntos+1 where id=new.e1;\nupdate equipo set puntos=puntos+1 where id=new.e2;\nupdate equipo set e=e+1 where id=new.e2; \nupdate equipo set e=e+1 where id=new.e1;\nend if;\nupdate equipo set gf=gf+new.g1 where id=new.e1;\nupdate equipo set gf=gf+new.g2 where id=new.e2;\nupdate equipo set gc=gc+new.g2 where id=new.e1;\nupdate equipo set gc=gc+new.g1 where id=new.e2;\n\n\nend' 'CREATE DEFINER=`root`@`localhost` trigger adpartido after delete on partido\nfor each row\nbegin\n\nif (old.g1> old.g2) then update equipo set puntos=puntos-3 where id=old.e1;\nupdate equipo set v=v-1 where id=old.e1; \nupdate equipo set d=d-1 where id=old.e2;\nelseif (old.g1< old.g2) then update equipo set puntos=puntos-3 where id=old.e2;\nupdate equipo set v=v-1 where id=old.e2; \nupdate equipo set d=d-1 where id=old.e1;\nelse update equipo set puntos=puntos-1 where id=old.e1;\nupdate equipo set puntos=puntos-1 where id=old.e2;\nupdate equipo set e=e-1 where id=old.e2; \nupdate equipo set e=e-1 where id=old.e1;\nend if;\nupdate equipo set gf=gf-old.g1 where id=old.e1;\nupdate equipo set gf=gf-old.g2 where id=old.e2;\nupdate equipo set gc=gc-old.g2 where id=old.e1;\nupdate equipo set gc=gc-old.g1 where id=old.e2;\n\n\nend'
